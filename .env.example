
# --- LLM (Ollama, yerel) ---
# Uzak/bulut uca gecmek icin:
#   RAG_LLM__PROVIDER=openai_compat
#   RAG_LLM__BASE_URL=https://<saglayici>/v1
#   RAG_LLM_API_KEY=<anahtar>
RAG_LLM__MODEL=gemma3:4b

# --- Vektör deposu ---
# Varsayılan: faiss (lokal). Qdrant Cloud için:
#   RAG_STORE__BACKEND=qdrant
#   RAG_QDRANT_URL=https://<cluster-id>.cloud.qdrant.io
#   RAG_QDRANT_API_KEY=<api-anahtari>
